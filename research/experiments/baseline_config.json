{
  "experiment_version": "1.0",
  "benchmark": {
    "release": "AegisBench-v1",
    "development_static_file": "../aegisbench/splits/development_static_v1.json",
    "heldout_static_file": "../aegisbench/splits/heldout_static_v1.json",
    "development_case_count": 876,
    "heldout_case_count": 522,
    "heldout_source_version": "1.0-static",
    "heldout_source_sha256": "17865ea0648f234efa0d777f71b6ceb68f7f5ab1ae178b66a98fc7309beab0e86"
  },
  "systems": {
    "B0_direct": {
      "name": "Direct Execution",
      "description": "Requests are sent directly to the controlled tool fixtures without a governance gateway.",
      "gateway_enabled": false,
      "parameter_constraints": false,
      "path_constraints": false
    },
    "B1_rbac": {
      "name": "Coarse-Grained RBAC",
      "description": "Authorization is based on agent, tool, and action. Parameter-level and path-level constraints are intentionally not enforced.",
      "gateway_enabled": true,
      "parameter_constraints": false,
      "path_constraints": false
    },
    "B2_aegis": {
      "name": "Aegis",
      "description": "Requests are evaluated by the Aegis policy gateway before reaching the controlled tool fixtures.",
      "gateway_enabled": true,
      "parameter_constraints": true,
      "path_constraints": true
    }
  },
  "endpoints": {
    "gateway": {
      "base_url": "http://localhost:8080"
    },
    "rbac": {
      "base_url": "http://localhost:8090"
    },
    "payments": {
      "base_url": "http://localhost:8081"
    },
    "files": {
      "base_url": "http://localhost:8082"
    },
    "unknown-tool": {
      "base_url": "http://localhost:8083"
    }
  },
  "request": {
    "agent_header": "X-Agent-ID",
    "content_type": "application/json",
    "timeout_seconds": 5
  },
  "metrics": {
    "classification": [
      "true_positive",
      "true_negative",
      "false_positive",
      "false_negative",
      "unclassified",
      "precision",
      "recall",
      "f1"
    ],
    "security": [
      "unauthorized_execution_rate",
      "legitimate_task_success_rate"
    ],
    "latency": [
      "mean_ms",
      "median_ms",
      "p50_ms",
      "p95_ms",
      "p99_ms"
    ]
  },
  "execution": {
    "mode": "live_http",
    "default_repetitions": 30,
    "record_responses": true,
    "record_latency": true,
    "fail_fast": true,
    "allow_stateful": false
  },
  "reproducibility": {
    "record_git_commit": true,
    "record_benchmark_hash": true,
    "record_policy_version": true,
    "record_experiment_timestamp": true
  }
}
