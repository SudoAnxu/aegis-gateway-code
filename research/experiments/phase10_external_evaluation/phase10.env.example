# Copy this file to a local, untracked environment file or export variables in your shell.
# NEVER commit a real API key.

# Provider: groq or openrouter
LLM_PROVIDER=groq
LLM_API_KEY=

# Put the exact model slug supported by your provider.
# For OpenRouter, openrouter/free selects a currently available free model
# that supports the requested capabilities; for reproducible papers, prefer
# pinning one concrete free model slug and recording it in the result artifact.
LLM_MODEL=

# Optional. Defaults are selected from LLM_PROVIDER.
# Groq: https://api.groq.com/openai/v1/chat/completions
# OpenRouter: https://openrouter.ai/api/v1/chat/completions
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512

# Local Aegis gateway.
AEGIS_BASE_URL=http://127.0.0.1:8080
AEGIS_TIMEOUT=30

# Optional OpenRouter metadata headers.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Aegis Phase 10 Evaluation
